# Copy to cluster.env at the repository root and edit before running scripts.
# Shell assignments, not JSON. Keep cluster.env private; never commit it.
# You may select another file with CLUSTER_ENV=/absolute/path/cluster.env.
# Scripts export these settings. deploy.py itself reads environment variables.

# Three SSH names, rank 0/head first. These are not RoCE rendezvous addresses.
SPARK_HOSTS='spark1 spark2 spark3'
# The same SSH user on each Spark.
SPARK_USER='ubuntu'
# Local SSH identity used by this checkout to reach the Sparks.
SSH_KEY="$HOME/.ssh/id_ed25519"
# Head address and subnet on the RoCE network; change to your topology.
MASTER_ADDR='10.0.0.1'
NCCL_IB_ADDR_RANGE='10.0.0.0/24'
# Per-Spark root: weights/, ranks/, bin/, kit/, spill/, logs/, guard/, service/, api/.
# Quote ~ so it expands on the Spark, not on your launch machine.
SPARK_ROOT='~/ds1017'

# Weights: https://huggingface.co/ChimeraWerks/DeepSeek-V4.1-Flash-1017-EXL3-3.84bpw-abliterated
HF_REPO='ChimeraWerks/DeepSeek-V4.1-Flash-1017-EXL3-3.84bpw-abliterated'
# The tested weights commit; prepare.sh downloads exactly this revision.
HF_REVISION='2fa62d701ce4a98abafd0be51ad2048dc88b8180'

# v1.2 release assertions; checked against release/manifest.json before launch.
# These are not tuning overrides or a binary downloader/version switch.
# Change a release via its manifest, keeping API and engine settings together.
ENGINE_COMMIT='678ea1b'
STREAMS='16'
POOL_TOKENS='8000000'
CONTEXT_TOKENS='1048576'
GRAPH_CAP='128'
SPILL_GIB='256'
MEMORY_RESERVE_GIB='4'
TOP_K='20'
# Rank 0 engine and serving API ports on the head. Both bind loopback by default.
ENGINE_PORT='8003'
API_PORT='18002'
# Empty: start.sh generates a key on the head, or reuses its existing 0600 file.
# Prefer leaving empty. Nothing ever prints the key or downloads it to this PC.
SPARK_API_KEY=''
# Separate admin credential for /admin/settings (effort remapping and presets).
# Empty: generate or reuse SPARK_ADMIN_KEY in the same 0600 file on the head.
# Serving clients never gain admin privileges; the two keys must be distinct.
SPARK_ADMIN_KEY=''

# Optional topology overrides (defaults below are suitable for the TP3 recipe).
# Head identity for head-to-worker SSH; must exist there.
# HEAD_SSH_KEY='~/.ssh/id_ed25519'
# SPARK_HOME='/home/ubuntu'  # for remote ~/ expansion; defaults to /home/$SPARK_USER
# TP_PORT='29660'
# ENGINE_HOST='127.0.0.1'
# API_HOST='127.0.0.1'
# SPARK_PYTHON='python3'
# ENGINE_LABEL='ds1017'
# API_INSTALLATION='ds1017'  # API user unit: ds1017-api
# NCCL_IB_HCA='rocep1s0f0,roceP2p1s0f0,rocep1s0f1,roceP2p1s0f1'
# TF_RDMA_DEVICES="$NCCL_IB_HCA"  # defaults to NCCL_IB_HCA; only set after it
# NCCL_SOCKET_IFNAME='=enP7s7'
# TF_RDMA_GID_INDEX='3'
# RDMA_PEER_MASKS='0,12,3 3,0,12 12,3,0'
# SPARK_LD_LIBRARY_PATH='/usr/local/cuda/lib64:/usr/lib/aarch64-linux-gnu'
# Add your custom NCCL library directory above if required by your engine build.

# Engram tables: 'ranged' fetches only this rank's rows from DeepSeek's repository (67.6 GB);
# 'full' downloads both complete shards (203 GB). See docs/runtime-assets.md.
# ENGRAM_SOURCE='ranged'

# Optional Spark-side absolute paths; defaults are beneath SPARK_ROOT.
# BIN_DIR='~/ds1017/bin'
# MODEL_DIR='~/ds1017/weights'
# RANK_CACHE='~/ds1017/ranks'
# KIT_DIR='~/ds1017/kit'
# ENGRAM_DIR='~/ds1017/weights/engram-tp3'
# SPILL_DIR='~/ds1017/spill'
# GUARD_SCRIPT='~/ds1017/guard/memguard.py'
# LOGGER_SCRIPT='~/ds1017/service/rotating_run.py'
# API_CONFIG='~/ds1017/api/config.json'
# API_ENV_FILE='~/ds1017/api/credentials.env'

# Optional local build/receipt paths (absolute recommended).
# OUT='/path/to/checkout/engine/build/out'  # same prefix passed to build.sh
# DEPLOY_RECEIPT='/path/to/checkout/.state/deploy-execution.json'
# ENGINE_HEALTH_URL='http://127.0.0.1:8003'  # optional local tunnel; normally SSH
# OPTIONAL_CONTROLLER_URL=''  # optional existing affinity controller; no dependency by default
